{
  "name": "clickculture-videoschnitt",
  "version": "1.0.0",
  "private": true,
  "description": "Videoschnitt per Code mit Remotion — Kurzvideos, Ads und Motion Graphics fuer Clickculture",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "schneiden": "node werkzeuge/schneiden.mjs",
    "transkribieren": "node werkzeuge/transkribieren.mjs",
    "schnittplan": "node werkzeuge/schnittplan.mjs",
    "kurzvideo": "bash werkzeuge/rendern.sh Kurzvideo ausgabe/kurzvideo.mp4",
    "werbeclip": "bash werkzeuge/rendern.sh Werbeclip ausgabe/werbeclip.mp4",
    "pruefen": "tsc --noEmit",
    "vlogplan": "node werkzeuge/vlogplan.mjs",
    "vlog": "bash werkzeuge/rendern.sh Vlog ausgabe/vlog.mp4",
    "klaenge": "python3 werkzeuge/klaenge-bauen.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "@remotion/fonts": "4.0.525",
    "@remotion/install-whisper-cpp": "4.0.525",
    "@remotion/media-utils": "^4.0.525",
    "@remotion/noise": "^4.0.525",
    "@remotion/shapes": "^4.0.525",
    "@remotion/transitions": "^4.0.525",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.525"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
